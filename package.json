{
  "name": "@testingfloor/js",
  "version": "0.3.1",
  "description": "Testing Floor JavaScript SDK: gameplay telemetry and recording sync for browsers, Node.js, Bun, Deno, and workers.",
  "keywords": [
    "testingfloor",
    "telemetry",
    "analytics",
    "playtest",
    "gamedev",
    "javascript",
    "node",
    "browser"
  ],
  "homepage": "https://github.com/capitalisminc/testingfloor-sdk-js#readme",
  "bugs": "https://github.com/capitalisminc/testingfloor-sdk-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capitalisminc/testingfloor-sdk-js.git"
  },
  "license": "MIT",
  "author": "Testing Floor",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      },
      "default": "./dist/esm/browser.js"
    },
    "./internal": {
      "import": {
        "types": "./dist/esm/internal.d.ts",
        "default": "./dist/esm/internal.js"
      },
      "require": {
        "types": "./dist/cjs/internal.d.ts",
        "default": "./dist/cjs/internal.js"
      },
      "default": "./dist/esm/internal.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:browser": "npm run build && node scripts/check-package.mjs --browser",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
